{
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@tailwindcss/postcss": "^4.1.18",
    "cheerio": "^1.1.2",
    "compromise": "^14.14.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-fsrs": "^5.2.3"
  },
  "scripts": {
    "dev": "npm --prefix vocab-app run dev",
    "build": "npm --prefix vocab-app run build",
    "supabase": "supabase",
    "supabase:login": "supabase login --agent no --output-format text",
    "supabase:link": "supabase link --project-ref qucyaothykoxwluaezwh",
    "db:pull": "supabase db pull --linked --agent no --output-format text",
    "db:migrations": "supabase migration list --linked",
    "db:new": "supabase migration new",
    "db:plan": "node scripts/supabase-db.mjs plan",
    "db:push": "node scripts/supabase-db.mjs push",
    "reminders:keys": "node scripts/setup-review-push.mjs",
    "reminders:secrets": "supabase secrets set --env-file .env.review-push.local --project-ref qucyaothykoxwluaezwh",
    "functions:deploy:reminders": "supabase functions deploy review-reminders --project-ref qucyaothykoxwluaezwh --use-api",
    "functions:deploy": "supabase functions deploy ai-dictionary --project-ref qucyaothykoxwluaezwh --use-api"
  },
  "devDependencies": {
    "supabase": "2.120.0",
    "vite": "^7.3.1"
  }
}
